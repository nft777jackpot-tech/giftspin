# Сеть TON: testnet для проверки на тестовых монетах, mainnet только после хостинга с HTTPS
TON_NETWORK=testnet
PORT=8787

# Секретная фраза горячего кошелька проекта (24 слова). Создаётся командой npm run wallet:new,
# никому не пересылается и не попадает в git
WALLET_MNEMONIC=

# Ключ toncenter (бот @tonapibot) поднимает лимит с 1 до 10 запросов в секунду. Необязателен
TONCENTER_API_KEY=

# Токен бота из @BotFather: нужен, чтобы проверять подпись данных Telegram при входе из Mini App,
# и для склада подарков. Для склада в @BotFather включите Bot Settings → Business Mode
BOT_TOKEN=

# Склад подарков: telegram — аккаунт-склад в Telegram для бизнеса с подключённым ботом (по умолчанию, если есть BOT_TOKEN);
# fake — тестовый склад из fixtures/stock.json, только testnet; off — без склада
WAREHOUSE=

# Вход без Telegram для проверки в браузере. Работает только в testnet
DEV_AUTH=1

# Пароль для админских запросов (одобрение крупных выводов). Создаётся командой npm run wallet:new
ADMIN_TOKEN=

# Ставки и выигрыши пока считает сайт, а сервер им верит. Только для testnet, до переноса игр на сервер
TRUST_CLIENT_GAMES=1

# Лимиты в TON
MIN_DEPOSIT_TON=0.1
MIN_WITHDRAW_TON=0.5
MAX_WITHDRAW_TON=50
REVIEW_OVER_TON=10
DAILY_WITHDRAW_TON=100
WITHDRAW_FEE_TON=0.05
